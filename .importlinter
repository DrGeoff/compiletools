# import-linter contracts — machine-checkable encoding of the module
# architecture documented in CLAUDE.md ("Architecture / Build flow").
#
# These contracts describe the layering that holds TODAY. They exist to
# make a future accidental layering violation (a leaf module reaching up
# into a backend, config importing a backend, etc.) fail loudly in CI via
# `lint-imports` and the drift-guard test_import_contracts.py, instead of
# rotting silently.
#
# Run locally with:  uv run lint-imports
#
# NOTE for maintainers: if a genuinely-intended new edge trips a contract,
# fix the layering — do NOT loosen a contract without understanding why the
# edge is sound. Exemptions live in `ignore_imports` with a comment naming
# the debt.

[importlinter]
root_package = compiletools
# include_external_packages is required for contract 6 below, which forbids
# stdlib modules (os, sys, ...) that live outside root_package. This widens
# the grimp-built graph to include every external package reachable from
# compiletools, not just os/sys/subprocess/shutil/pathlib -- measured no
# regression versus the pre-change baseline (~0.25-0.33s either way, run to
# run noise dominates), still comfortably inside the "fast, file-independent"
# budget the import-linter hook comment documents.
include_external_packages = True

# ---------------------------------------------------------------------------
# Contract 1: the documented build pipeline spine is a one-way stack.
#
# High to low: orchestrator (cake) > concrete backends > backend base
# (build_backend) > deps (hunter > magicflags > headerdeps) > targets
# (findtargets). A lower layer importing a higher one is forbidden (checked
# transitively, so no laundering the edge through a helper module).
#
# The concrete backends share a single layer line: they are independent of
# each other (none imports a sibling backend) but all sit above the base.
#
# Deliberately NOT layered here: the foundation cluster (apptools,
# configutils, flags, git_utils, apptools_argparse, namer, file_analyzer,
# global_hash_registry, build_context). Those modules are a tightly
# cross-referencing bootstrap cluster with real transitive back-edges
# (e.g. configutils -> apptools_argparse -> apptools; flags -> git_utils ->
# apptools; namer -> global_hash_registry -> build_context -> file_analyzer),
# so no strict linear order holds without a refactor. Their one invariant
# that DOES hold today — "never import a backend or a CLI/report tool" — is
# enforced by the forbidden contracts below instead.
# ---------------------------------------------------------------------------
[importlinter:contract:pipeline-layers]
name = Build pipeline spine (targets -> deps -> backends -> orchestrator)
type = layers
layers =
    compiletools.cake
    compiletools.makefile_backend | compiletools.ninja_backend | compiletools.cmake_backend | compiletools.bazel_backend | compiletools.trace_backend
    compiletools.build_backend
    compiletools.hunter
    compiletools.magicflags
    compiletools.headerdeps
    compiletools.findtargets

# ---------------------------------------------------------------------------
# Contract 2: foundational / config modules must never import a backend.
#
# flags, apptools, utils, configutils and file_analyzer are the load-bearing
# leaves the whole tree depends on. If any of them reached into the heavy
# `*_backend` / build_backend modules it would create an import cycle risk
# and invert the documented "config does not know about backends" rule.
# ---------------------------------------------------------------------------
[importlinter:contract:foundation-no-backends]
name = Foundation and config modules must not import any backend
type = forbidden
source_modules =
    compiletools.flags
    compiletools.apptools
    compiletools.utils
    compiletools.configutils
    compiletools.file_analyzer
forbidden_modules =
    compiletools.build_backend
    compiletools.makefile_backend
    compiletools.ninja_backend
    compiletools.cmake_backend
    compiletools.bazel_backend
    compiletools.trace_backend

# ---------------------------------------------------------------------------
# Contract 3: the dependency-analysis layer must not import backends.
#
# hunter / headerdeps / magicflags implement the #include-graph walk and
# magic-flag extraction. Backends consume them, never the reverse — keeping
# the deps layer backend-agnostic is what lets any backend reuse it.
# ---------------------------------------------------------------------------
[importlinter:contract:deps-no-backends]
name = Dependency-analysis modules must not import any backend
type = forbidden
source_modules =
    compiletools.hunter
    compiletools.headerdeps
    compiletools.magicflags
forbidden_modules =
    compiletools.build_backend
    compiletools.makefile_backend
    compiletools.ninja_backend
    compiletools.cmake_backend
    compiletools.bazel_backend
    compiletools.trace_backend

# ---------------------------------------------------------------------------
# Contract 4: core library modules must not import the CLI / diagnostic
# report tools.
#
# These entry-point-only tools (ct-cache-report, ct-trim-cache,
# ct-list-backends, ct-list-variants, ct-debug-pcm-hash-inputs, ct-doc,
# ct-git-sha-report) sit at the top of the stack. A core library module
# importing one would drag a reporting/CLI tool into the hot build path.
#
# git_sha_report is now a strict leaf entry point: its git-hashing library was
# extracted to the pure-library compiletools.git_sha, which global_hash_registry
# imports directly. So git_sha_report can join the forbidden list below — the
# former dual-role exemption is gone.
# ---------------------------------------------------------------------------
[importlinter:contract:core-not-import-cli-tools]
name = Core library modules must not import CLI / diagnostic report tools
type = forbidden
source_modules =
    compiletools.flags
    compiletools.apptools
    compiletools.utils
    compiletools.configutils
    compiletools.file_analyzer
    compiletools.namer
    compiletools.headerdeps
    compiletools.magicflags
    compiletools.hunter
    compiletools.findtargets
    compiletools.build_backend
forbidden_modules =
    compiletools.cache_report
    compiletools.trim_cache
    compiletools.listbackends
    compiletools.listvariants
    compiletools.debug_pcm_hash_inputs
    compiletools.doc
    compiletools.git_sha_report

# ---------------------------------------------------------------------------
# Contract 5: the concrete backends are independent of one another.
#
# Each backend (make / ninja / cmake / bazel / shake-trace) is a peer plugin
# resolved through backend_registry; none may import another directly. This
# keeps the registry the single dispatch point and prevents a backend from
# accidentally coupling to a sibling's internals.
# ---------------------------------------------------------------------------
[importlinter:contract:backends-independent]
name = Concrete backends are independent of one another
type = independence
modules =
    compiletools.makefile_backend
    compiletools.ninja_backend
    compiletools.cmake_backend
    compiletools.bazel_backend
    compiletools.trace_backend

# ---------------------------------------------------------------------------
# Contract 6: build_state stays pure (no ambient authority).
#
# build_state.py implements the functional-core stages of substitutions() --
# gather_inputs owns every effectful read (env vars, filesystem, pkg-config
# subprocess calls); build_state must stay a pure function of BuildInputs so
# it can be property-tested without mocking. Transitive os via configutils /
# flags is accepted (see CLAUDE.md "Foundation cluster" note) -- this
# contract targets build_state's OWN import statements only.
#
# `forbidden` contracts are transitive by default (a chain through any
# intermediate module still counts). `allow_indirect_imports = True` switches
# to direct-only checking (grimp's find_modules_directly_imported_by), which
# is the only way to express "no direct os import, transitive os is fine" --
# without it, this contract would immediately break on build_state's real
# `import compiletools.configutils` edge (configutils -> ... -> os).
# ---------------------------------------------------------------------------
[importlinter:contract:build-state-pure]
name = build_state stays pure (no ambient authority)
type = forbidden
source_modules =
    compiletools.build_state
forbidden_modules =
    os
    sys
    subprocess
    shutil
    pathlib
allow_indirect_imports = True

[importlinter:contract:flag-ops-is-a-leaf]
name = flag_ops stays a leaf (no compiletools imports at all)
type = forbidden
source_modules =
    compiletools.flag_ops
forbidden_modules =
    compiletools.apptools
    compiletools.flags
    compiletools.headerdeps
    compiletools.utils
    compiletools.build_state
    compiletools.build_backend
ignore_imports =
    # The one exception, deliberate and call-time only: dedup_tokens
    # delegates to utils.deduplicate_compiler_flags rather than forking a
    # second copy of the pair-aware equality. Deferring the import to call
    # time keeps flag_ops' MODULE-level surface stdlib-only, which is what
    # lets flags.py import it at top level without reviving the historical
    # flags <-> apptools cycle. Any new edge here needs the same argument.
    compiletools.flag_ops -> compiletools.utils
